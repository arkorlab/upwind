{
  "name": "upwind",
  "version": "0.4.0",
  "description": "The upwind CLI: develop, build and preview Next.js applications, and deploy them to Cloudflare or AWS Fargate.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkorlab/upwind.git",
    "directory": "packages/upwind"
  },
  "bin": {
    "upwind": "./src/cli.ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    "./websocket-dev": "./src/websocket-dev.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "upwind": "./dist/cli.js"
    },
    "exports": {
      "./websocket-dev": "./dist/websocket-dev.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/deploy/workers",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.1162.0",
    "@aws-sdk/client-cloudfront": "3.1162.0",
    "@aws-sdk/client-ec2": "3.1162.0",
    "@aws-sdk/client-ecr": "3.1162.0",
    "@aws-sdk/client-ecs": "3.1162.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "3.1162.0",
    "@aws-sdk/client-elasticache": "3.1162.0",
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/client-secrets-manager": "3.1162.0",
    "@aws-sdk/credential-provider-node": "3.972.93",
    "@stayingupwind/core": "workspace:*",
    "miniflare": "catalog:",
    "rolldown": "catalog:",
    "tldts": "catalog:",
    "wrangler": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@stayingupwind/cache": "workspace:*",
    "@stayingupwind/deploy": "workspace:*",
    "@stayingupwind/edge": "workspace:*",
    "@stayingupwind/host": "workspace:*",
    "@stayingupwind/local": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "next": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "next": ">=16.2.0 <17"
  },
  "engines": {
    "node": ">=24.10"
  }
}

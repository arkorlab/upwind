{
  "name": "@stayingupwind/adapter",
  "version": "0.4.0",
  "description": "Next.js deployment adapter: turns `next build` output into a content-addressed deployment bundle and the Functions that serve it.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkorlab/upwind.git",
    "directory": "packages/adapter"
  },
  "files": [
    "dist",
    "src",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./project-config": "./src/project-config.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./project-config": {
        "types": "./dist/project-config.d.ts",
        "default": "./dist/project-config.js"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jridgewell/sourcemap-codec": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "@stayingupwind/core": "workspace:*",
    "@stayingupwind/runtime": "workspace:*",
    "jsonc-parser": "catalog:",
    "oxc-parser": "catalog:",
    "rolldown": "catalog:"
  },
  "devDependencies": {
    "@oxc-project/types": "catalog:",
    "@types/node": "catalog:",
    "miniflare": "catalog:",
    "next": "catalog:",
    "next-16-4-3": "npm:next@16.4.3",
    "next-16-4-4": "npm:next@16.4.4",
    "next-16-4-5": "npm:next@16.4.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "next": ">=16.2.0 <17"
  },
  "engines": {
    "node": ">=24"
  }
}

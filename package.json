{
  "name": "upwind",
  "version": "0.4.0",
  "private": true,
  "description": "A Next.js deployment adapter and runtime with support for PPR and Cache Components.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkorlab/upwind.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check:cloudflare-workflows": "node packages/upwind/scripts/check-cloudflare-workflows.ts",
    "check:durable-objects": "node packages/upwind/scripts/check-durable-objects.ts",
    "check:agent-rules": "node packages/create-upwind/scripts/check-agent-rules.ts",
    "check:vocabulary": "node tools/vocabulary/src/main.ts",
    "check:patches": "node packages/adapter/scripts/check-patches.ts",
    "check:patches:range": "node packages/adapter/scripts/check-patches.ts --range",
    "check:patches:canary": "node packages/adapter/scripts/check-patches.ts --canary",
    "check:matrix": "node tools/next-matrix/src/run.ts",
    "check:deploy-tests": "node tools/deploy-tests/src/check.ts",
    "check:deploy-cloudflare": "node packages/upwind/scripts/check-deploy.ts",
    "check:preview": "node packages/upwind/scripts/check-preview.ts",
    "test:deploy": "node tools/deploy-tests/src/main.ts",
    "format": "oxfmt --check",
    "format:write": "oxfmt",
    "knip": "knip",
    "local:check": "node packages/local/src/main.ts check",
    "local:serve": "node packages/local/src/main.ts serve",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "check:ai": "node packages/upwind/scripts/check-ai.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-redos": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "eslint-plugin-security": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "globals": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortImports": {},
  "sortTailwindcss": {
    "stylesheet": "./apps/web/src/app/globals.css",
  },
  "sortPackageJson": {},
  "ignorePatterns": [
    "**/node_modules/**",
    // The application `create-upwind` writes: it ships as it is written, in the shape a Next.js
    // project has rather than the shape this repository's own sources have.
    "packages/create-upwind/templates/**",
    "**/.adapter-tests/**",
    "**/.next/**",
    "**/.wrangler/**",
    "**/dist/**",
    "**/coverage/**",
    "**/worker-configuration.d.ts",
    "**/next-env.d.ts",
    "**/drizzle/**",
    "pnpm-lock.yaml",
    "**/test/fixtures/**",
    // Written by `measure.ts`; kept as it was written.
    "packages/next-runtime/reports/**",
    // The bundled collector, one minified string; written by `generate`.
    "packages/vitals-script/generated/**",
    // Written by `pnpm third-party-licenses:generate`; `third-party-licenses:check` compares bytes.
    "apps/web/src/lib/licenses/third-party.json",
    "tools/licenses/third-party.lock.json",
  ],
}
